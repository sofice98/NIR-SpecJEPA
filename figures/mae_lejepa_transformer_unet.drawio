        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="MAE 与 LeJEPA：Transformer / U-Net 架构对比" style="text;html=1;align=center;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#17365D;" vertex="1" parent="1">

          <mxGeometry x="40" y="80" width="840" height="450" as="geometry"/>
        </mxCell>
        <mxCell id="p2" value="② MAE + U-Net" style="swimlane;startSize=42;rounded=1;html=1;fontSize=17;fontStyle=1;fillColor=#F7FFF8;strokeColor=#82B366;strokeWidth=2;container=1;pointerEvents=0;" vertex="1" parent="1">
          <mxGeometry x="920" y="80" width="840" height="450" as="geometry"/>
        </mxCell>

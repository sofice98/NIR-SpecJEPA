          <mxGeometry x="920" y="570" width="840" height="450" as="geometry"/>
        </mxCell>

        <mxCell id="mti" value="输入光谱 x&#xa;(B, L)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;" vertex="1" parent="p1"><mxGeometry x="30" y="90" width="110" height="65" as="geometry"/></mxCell>
        <mxCell id="mtm" value="Patchify + Mask&#xa;被遮挡 patch → mask token" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;" vertex="1" parent="p1"><mxGeometry x="175" y="80" width="150" height="85" as="geometry"/></mxCell>
        <mxCell id="mte" value="Transformer Encoder&#xa;Patch projection + 位置编码&#xa;Self-Attention + MLP × depth" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;fontStyle=1;" vertex="1" parent="p1"><mxGeometry x="365" y="65" width="190" height="115" as="geometry"/></mxCell>
        <mxCell id="mtd" value="MLP Patch Decoder&#xa;Linear → GELU → Linear&#xa;每个 token → patch_size" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=12;fontStyle=1;" vertex="1" parent="p1"><mxGeometry x="595" y="65" width="180" height="115" as="geometry"/></mxCell>
        <mxCell id="mto" value="重建被遮挡 patch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;" vertex="1" parent="p1"><mxGeometry x="615" y="230" width="140" height="60" as="geometry"/></mxCell>

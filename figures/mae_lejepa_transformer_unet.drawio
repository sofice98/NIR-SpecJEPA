        <mxCell id="muo" value="重建完整光谱&#xa;并恢复 patch 形状" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;" vertex="1" parent="p2"><mxGeometry x="615" y="230" width="140" height="60" as="geometry"/></mxCell>
